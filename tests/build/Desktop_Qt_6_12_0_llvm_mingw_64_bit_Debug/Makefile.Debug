####### Install

install_target: first FORCE
	@test -d G:$(INSTALL_ROOT:@msyshack@%=%)/Qt/6.12.0/llvm-mingw_64/tests/tests || mkdir -p G:$(INSTALL_ROOT:@msyshack@%=%)/Qt/6.12.0/llvm-mingw_64/tests/tests
	-$(INSTALL_FILE) $(DESTDIR_TARGET) G:$(INSTALL_ROOT:@msyshack@%=%)/Qt/6.12.0/llvm-mingw_64/tests/tests/$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) G:$(INSTALL_ROOT:@msyshack@%=%)/Qt/6.12.0/llvm-mingw_64/tests/tests/$(TARGET)
	-$(DEL_DIR) G:$(INSTALL_ROOT:@msyshack@%=%)/Qt/6.12.0/llvm-mingw_64/tests/tests/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

